# VHS-Security
SECRET_KEY=change-me-long-random-string
VHS_SECURITY_USER=admin
VHS_SECURITY_PASSWORD=change-me
VHS_SECURITY_DATA=./data

# Единственный источник камер, потоков и событий — VHS-Viewer.
VIEWER_URL=http://127.0.0.1:8200

# Должен совпадать с VHS_SECURITY_INGEST_TOKEN в VHS-Viewer.
VHS_SECURITY_INGEST_TOKEN=change-me-ingest-token

# Должен совпадать с security.sso_secret в Streamer и Viewer.
VHS_SSO_SECRET=change-me-sso-secret

# Optional
GEO_LAYER=
# leaflet (OpenStreetMap) or yandex
GEO_MAP_PROVIDER=leaflet
YANDEX_MAPS_API_KEY=
VHS_SECURITY_HOST=127.0.0.1
VHS_SECURITY_PORT=8300
